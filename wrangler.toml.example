#:schema node_modules/wrangler/config-schema.json
# 由 CI 从本模板生成 wrangler.toml(不入库),sed 替换以下占位符:
#   __WORKER_NAME__ / __D1_NAME__ / __D1_DATABASE_ID__ / __CRON_EXPRESSION__
# 业务 secrets(TG token、Resend key、管理密码哈希等)只存 D1 settings,不进本文件(spec:product/notifications.md)。
name = "__WORKER_NAME__"
main = "src/index.ts"
compatibility_date = "2026-09-01"

[triggers]
crons = ["__CRON_EXPRESSION__"]

[[d1_databases]]
binding = "DB"
database_name = "__D1_NAME__"
database_id = "__D1_DATABASE_ID__"

# 需在 Dashboard 开启 Email(Compute → Email Service)后部署才生效;本地 dev 可注释掉
[[send_email]]
name = "SEND_EMAIL"

# Workers 可观测性:logs/traces 全量头采样并持久化,Dashboard(Observability)可查报错与调用链;
# 免费档额度内(2026-10-07 核实,见 spec:product/external-facts.md)
[observability.logs]
enabled = true
head_sampling_rate = 1
invocation_logs = true
persist = true

[observability.traces]
enabled = true
head_sampling_rate = 1
persist = true
